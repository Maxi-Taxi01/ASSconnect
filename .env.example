# ASSconnect server configuration
# Copy this file to .env and adjust for your environment.
# In production (NODE_ENV=production) no demo accounts or seed data are created.

# Runtime mode. Use "production" for live deployments.
NODE_ENV=development

# HTTP port the server listens on.
PORT=4173

# Initial administrator account (created only when the database is first seeded).
# Set a strong password before the first production start; otherwise a random
# one is generated and must be set via the password-reset flow.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ASSconnect Admin
ADMIN_PASSWORD=

# Storage locations (override to point at managed volumes / object storage mounts).
# DATA_DIR=/var/lib/assconnect/data
# DB_FILE=/var/lib/assconnect/data/app-db.json
# UPLOADS_DIR=/var/lib/assconnect/uploads

# Transactional email (SMTP). When SMTP_HOST is unset, mail is written to a local outbox.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@assconnect.nl
